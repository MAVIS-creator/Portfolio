{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/terminal.html",
      "destination": "/portfolio/",
      "permanent": true
    },
    { "source": "/terminal", "destination": "/portfolio/", "permanent": true },
    {
      "source": "/project-quantyx.html",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/project-quantyx",
      "destination": "/projects",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blog/article/:slug",
      "destination": "/blog/post?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
